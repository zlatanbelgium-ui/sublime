    <script>
        $(function() {
            const inputDisplay = $('#pass_key_display');
            const inputHidden = $('#pass_key_hidden');
            const toggleBtn = $('#toggle_pass_key');
            const icon = toggleBtn.find('i');
            const form = $('#form-login');

            let rawPassword = '';
            let isVisible = false;

            inputDisplay.on('input', function(e) {
                const newVal = inputDisplay.val();
                const prevLength = rawPassword.length;
                const cursorPos = this.selectionStart;
                const addedChar = e.originalEvent?.data || '';

                if (newVal.length > prevLength) {
                    rawPassword =
                        rawPassword.slice(0, cursorPos - 1) + addedChar + rawPassword.slice(cursorPos - 1);
                } else if (newVal.length < prevLength) {
                    rawPassword =
                        rawPassword.slice(0, cursorPos) + rawPassword.slice(cursorPos + (prevLength - newVal.length));
                }

                if (!isVisible) {
                    inputDisplay.val('*'.repeat(rawPassword.length));
                }
            });

            toggleBtn.on('click', function() {
                isVisible = !isVisible;

                if (isVisible) {
                    inputDisplay.val(rawPassword);
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    inputDisplay.val('*'.repeat(rawPassword.length));
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            form.on('submit', function() {
                inputHidden.val(rawPassword);
            });
        });

