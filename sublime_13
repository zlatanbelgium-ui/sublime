                function handleLogin($user_n, $pass_key, $comfunc, $logins, $index)
                {
                    // Validasi kosong
                    if ($user_n === "" || $pass_key === "") {
                        alertAndRedirect("Username / Password tidak boleh kosong !!!", $index);
                        return;
                    }

                    // var_dump("a1a");
