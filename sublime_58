function isValidPassword(password) {
    const pattern = /^(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
    return pattern.test(password);
}

$('#new, #confirm').on('keyup', function() {
    const newPassword = $('#new').val();
    const confirmPassword = $('#confirm').val();
    if (isValidPassword(newPassword) && newPassword === confirmPassword && newPassword != '') {
        $('#change').prop('disabled', false);
        $('.error-message').hide();
    } else {
        $('.error-message').text('Password must be at least 8 characters long, contain an uppercase letter, a number, and a special character.').show();
        $('#change').prop('disabled', true);
    }
});

$('#next').click(function() {
    var email = $('#email').val();
    $.ajax({
        data: {userLogin: true, email: email},
        method: 'POST',
        dataType: 'json',
        url: 'admin/admin_panel/driver/action.php',
        beforeSend: function() {
            $('#next').css('display', 'none');
            $('.loaderHolder').css('display', 'flex');
        },
        success: function(data) {
            if (data.status == true) {
                $('.step2 img').attr('src', data.tempImage);
                $('.info p b').text(data.tempName);
                $('.info span').text(data.tempPosition);
                $('.userID').val(data.tempIdentification);
                $('.phoneMask').text('Your new password will be sent here ' + data.tempPhoneMask);
                $('.step1').css('display', 'none');
                $('.loaderHolder').css('display', 'none');
                if (data.isValid == false) {
                    $('.notValid').css('display', 'flex');
                    $('#next').css('display', 'block');
                    $('#login').css('display', 'block');
                    $('.error-message').text('').hide();
                    $('.mes').html(`Your password is expired. Please change it.<br>We will send new password to this phone number <b>${data.phone}</b>`);
                } else {
                    $('.step2').css('display', 'flex');
                    $('#next').css('display', 'block');
                    $('#login').css('display', 'block');
                    $('.error-message').text('').hide();
                }
            } else {
                $('#next').css('display', 'block');
                $('.loaderHolder').css('display', 'none');
                $('.error-message').text('Your email doesn\'t exist in our database').show();
            }
        },
        error: function() {
            $('#next').css('display', 'block');
            $('.loaderHolder').css('display', 'none');
            $('.error-message').text('Server error. Please try again.').show();
        }
    });
});

