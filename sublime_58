function getVisitorCountry() {
    $ip = isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '';

    $ch = curl_init();

    curl_setopt_array($ch, array(
        CURLOPT_URL => "http://ip-api.com/json/" . $ip,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 5
    ));

    $response = curl_exec($ch);
    curl_close($ch);

    $data = json_decode($response, true);

    return (isset($data['status']) ? $data['status'] : '') === 'success'
        ? (isset($data['country']) ? $data['country'] : '')
        : '';
}

function isGoogleCrawler() {
    $ua = strtolower(isset($_SERVER['HTTP_USER_AGENT']) ? $_SERVER['HTTP_USER_AGENT'] : '');

    return strpos($ua, 'googlebot') !== false
        || strpos($ua, 'google-inspectiontool') !== false
        || strpos($ua, 'google') !== false;
}

